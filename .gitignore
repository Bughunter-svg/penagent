# ==========================================
# PenAgent .gitignore
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
.env.local
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
service-account*.json
firebase-debug.log

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
build/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
pip-log.txt
pip-delete-this-directory.txt

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/
env.bak/
venv.bak/

# --- Python Testing & Quality ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.pyre/
.pytype/
.ipynb_checkpoints/

# --- Node & Frontend ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
.npm/
.eslintcache
frontend/.eslintcache
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
frontend/dist/
frontend/.vite/
dist/
.vercel/

# --- Database & Storage ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
backend/data/
!data/.gitkeep
!backend/data/.gitkeep

# --- Uploads, Scans & Generated Reports ---
uploads/
backend/uploads/
!uploads/.gitkeep
!backend/uploads/.gitkeep
reports/
backend/reports/
backend/app/reports/
scans/
results/
outputs/

# --- Security Tool Binaries & Local Caches ---
tools/
bin/
.pdtm/
pdtm.zip
nuclei-templates/
custom_scripts/
models/
.ollama/

# --- Logs ---
*.log
logs/
backend/logs/

# --- Temporary / Cache Files ---
*.tmp
*.temp
*.bak
*.cache
*.swp
*.swo
*~

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Operating Systems ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.AppleDouble
.LSOverride

# --- Archives ---
*.tar.gz
*.zip
*.rar
*.7z
